# Point these at your own LOCAL database; never commit real credentials.
DATABASE_URL=postgresql://syncproof:replace-me@127.0.0.1:5432/syncproof
# Tests create/drop only run-owned syncproof_test_* schemas in this database.
TEST_DATABASE_URL=postgresql://syncproof:replace-me@127.0.0.1:5432/syncproof_test
PORT=3000
# Optional Origin allowed to POST. Requests without Origin (CLI/tests) are allowed.
ALLOWED_ORIGIN=http://127.0.0.1:5174
